DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public"
# بدائل مدعومة لو Railway وفرها بدل DATABASE_URL:
# POSTGRES_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public"
# DATABASE_PRIVATE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public"
# أو PGHOST / PGPORT / PGUSER / PGPASSWORD / PGDATABASE
ENABLE_LEGACY_FILE_STORE="false"
NEXT_PUBLIC_SITE_URL="https://BadrDaawa.com"
# اكتب الرابط بدون رموز من واجهة Railway مثل ↗. لو نسيته بدون https:// سيقوم التطبيق بتصحيحه تلقائيًا.
AUTH_SECRET="change-this-long-random-secret"
ADMIN_USERNAME="admin"
ADMIN_EMAIL="owner@badrdaawa.com"
ADMIN_PASSWORD="change-this-admin-password"
ADMIN_SESSION_SECRET="change-this-admin-session-secret"
CLIENT_ADMIN_USERNAME="client"
CLIENT_ADMIN_PASSWORD="change-this-client-password"
CLIENT_SESSION_SECRET="change-this-client-session-secret"
SHOW_PHOTOGRAPHER_CARD="true"
NEXT_PUBLIC_VAPID_PUBLIC_KEY="change-this-vapid-public-key"
VAPID_PRIVATE_KEY="change-this-vapid-private-key"
VAPID_SUBJECT="mailto:owner@badrdaawa.com"
BACKUP_GITHUB_REPO="owner/badrdaawa-backups"
BACKUP_GITHUB_TOKEN="github_pat_xxx"
GITHUB_SYNC_ENABLED="true"
GITHUB_SYNC_REPO="badrabdoph-cell/BadrDaawa"
GITHUB_SYNC_BRANCH="main"
GITHUB_SYNC_TOKEN="github_pat_xxx"
# ─── النسخ الاحتياطية التلقائية (مطلوب) ────────────────────────────────────────
# المُجدول الداخلي (setInterval) تم إيقافه لأنه يعتمد على HTTP traffic ويُفقد
# عند إعادة تشغيل الحاوية. النسخ الاحتياطية الآن تعتمد على خدمة cron خارجية.
#
# الإعداد المطلوب:
#   1. اضبط BACKUP_CRON_SECRET بقيمة عشوائية طويلة وآمنة.
#   2. سجّل في خدمة cron خارجية (مثل EasyCron أو cron-job.org):
#        URL:    https://BadrDaawa.com/api/cron/backup
#        Method: POST
#        Header: Authorization: Bearer {BACKUP_CRON_SECRET}
#        Cron:   0 */6 * * *   (كل 6 ساعات)
#   3. اضبط BACKUP_CRON_URL بعنوان الـ endpoint للتوثيق.
#
# بدون هذا الإعداد لن تُنشأ أي نسخ احتياطية تلقائية.
BACKUP_CRON_SECRET="change-this-long-random-cron-secret"
BACKUP_CRON_URL="https://BadrDaawa.com/api/cron/backup"
WHATSAPP_ORDER_PHONE="01011511561"
